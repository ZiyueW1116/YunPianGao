{
  "name": "@ziyuew1116/yunpiangao",
  "version": "0.1.0",
  "description": "云片糕：Agent 空闲压缩与基于任务 handle 的等待接续",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZiyueW1116/YunPianGao.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./opencode": {
      "types": "./dist/adapters/opencode.d.ts",
      "import": "./dist/adapters/opencode.js"
    },
    "./server": {
      "types": "./dist/adapters/opencode.d.ts",
      "import": "./server.js"
    },
    "./pi": {
      "types": "./dist/adapters/pi.d.ts",
      "import": "./dist/adapters/pi.js"
    },
    "./claude": {
      "types": "./dist/adapters/claude.d.ts",
      "import": "./dist/adapters/claude.js"
    }
  },
  "files": [
    "dist",
    "server.js",
    "README.md",
    "LICENSE",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build_claude_mod.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:runtime": "npm run build && python3 test/runtime.py && python3 test/runtime_wait.py",
    "audit:public": "python3 scripts/audit_public.py",
    "prepack": "npm run build",
    "test:pi": "npm run build && node --test test/pi-runtime.test.mjs",
    "test:claude": "npm run build && node --test test/claude-runtime.test.mjs test/claude-defer.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@opencode/plugin": "2.1.4",
    "@anthropic-ai/claude-agent-sdk": "0.3.317"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.317",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@opencode/plugin": "2.1.4",
    "@types/node": "22.19.11",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "typebox": "1.3.27"
  }
}

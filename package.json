{
  "name": "@ziyuew1116/yunpiangao",
  "version": "0.1.0",
  "description": "云片糕：Agent 空闲压缩与基于任务 handle 的等待接续",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZiyueW1116/YunPianGao.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./opencode": {
      "types": "./dist/adapters/opencode.d.ts",
      "import": "./dist/adapters/opencode.js"
    },
    "./server": {
      "types": "./dist/adapters/opencode.d.ts",
      "import": "./server.js"
    },
    "./pi": {
      "types": "./dist/adapters/pi.d.ts",
      "import": "./dist/adapters/pi.js"
    },
    "./deepseek": {
      "types": "./dist/adapters/deepseek.d.ts",
      "import": "./dist/adapters/deepseek.js"
    }
  },
  "files": [
    "dist",
    "server.js",
    "README.md",
    "LICENSE",
    "docs",
    "scripts/patch-deepseek.mjs",
    "scripts/deepseek-host.patch.txt",
    "scripts/deepseek-overlay.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:runtime": "npm run build && python3 test/runtime.py && python3 test/runtime_wait.py",
    "audit:public": "python3 scripts/audit_public.py",
    "prepack": "npm run build",
    "test:pi": "npm run build && node --test test/pi-runtime.test.mjs",
    "precheck": "node scripts/patch-deepseek.mjs",
    "prebuild": "node scripts/patch-deepseek.mjs",
    "test:deepseek": "npm run build && node --test test/deepseek-runtime.test.mjs test/deepseek-profile.test.mjs",
    "test:legacy": "npm run build && node --test test/adapter.test.mjs test/opencode-wait.test.mjs test/pi-runtime.test.mjs test/scheduler.test.mjs test/wait.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@opencode/plugin": "2.1.4",
    "@deepseek-ai/cordis": "4.0.6-alpha.2",
    "@deepseek-ai/schemastery": "3.18.6-alpha.2",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.3"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction-basic": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.2",
    "@deepseek-ai/dsh": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-fs-local": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-sandbox-local": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session-projection": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-subagent": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-subprocess-local": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-working-directory": "0.2.2-alpha.3",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@opencode/plugin": "2.1.4",
    "@types/node": "22.19.11",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "typebox": "1.3.27"
  }
}

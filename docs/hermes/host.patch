@@ -322 +326,14 @@ class SubagentLifecycleService:
-        record.future = _EXECUTOR.submit(self._run, record, request.goal, parent)
+        from tools.delegate_tool import _close_child, _detach_child
+        try:
+            # 独立执行不随父轮的输入或中断结束；生命周期 owner 必须显式 cancel。
+            if request.independent:
+                _detach_child(parent, child)
+            record.future = _EXECUTOR.submit(self._run, record, request.goal, parent)
+        except BaseException:
+            with _REGISTRY.lock:
+                _REGISTRY.records.pop(subagent_id, None)
+                if request.correlation_id:
+                    _REGISTRY.correlations.pop(correlation_key, None)
+            _detach_child(parent, child)
+            _close_child(child, "子执行发布失败")
+            raise
@@ -453,0 +471,2 @@ class SubagentLifecycleService:

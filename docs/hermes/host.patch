@@ -199,0 +202,11 @@ def run_tool_round(
+    # 成功工具批次后的正常停放边界；调用方负责在 run_conversation 返回后接续。
+    boundary = getattr(agent, "tool_round_boundary", None)
+    if boundary is not None:
+        parked_response = boundary(messages)
+        if parked_response is not None:
+            if not isinstance(parked_response, str) or not parked_response:

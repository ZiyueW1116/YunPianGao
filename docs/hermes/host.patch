diff --git a/agent/subagent_lifecycle.py b/agent/subagent_lifecycle.py
index 6586547..63e5069 100644
--- a/agent/subagent_lifecycle.py
+++ b/agent/subagent_lifecycle.py
@@ -61,0 +62 @@ class SubagentLaunchRequest:
+    independent: bool = False
@@ -277 +278 @@ class SubagentLifecycleService:
-    def launch(self, request: SubagentLaunchRequest | Mapping[str, Any]) -> SubagentHandle:
+    def launch(self, request: SubagentLaunchRequest | Mapping[str, Any], *, cancel_check: Optional[Callable[[], bool]] = None) -> SubagentHandle:
@@ -309,2 +310,5 @@ class SubagentLifecycleService:
-        if not subagent_id:
-            raise SubagentLifecycleError("Hermes failed to assign a child identity.")
+        if not subagent_id or (cancel_check is not None and cancel_check()):
+            from tools.delegate_tool import _close_child, _detach_child
+            _detach_child(parent, child)
+            _close_child(child, "子执行在发布前结束")
